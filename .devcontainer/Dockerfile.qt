ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Qt runtime packages and Python tooling (independent of QT_VERSION)
RUN set -ex && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-venv p7zip-full \
        libgl1 libegl1 libxkbcommon0 libxkbcommon-x11-0 \
        libdbus-1-3 libfontconfig1 libfreetype6 \
        libx11-6 libx11-xcb1 libxcb1 libxcb-cursor0 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xkb1 && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Pinned aqtinstall (independent of QT_VERSION)
RUN python3 -m venv /opt/aqt && \
    /opt/aqt/bin/pip install --no-cache-dir "aqtinstall==3.3.0" && \
    rm -rf /root/.cache/pip

ARG TARGETARCH
ARG QT_VERSION

# Minimal Qt (qtbase + icu) for the requested version
RUN set -ex && \
    test -n "${QT_VERSION}" && \
    case "${TARGETARCH}" in \
        arm64) AQT_HOST=linux_arm64; AQT_ARCH=linux_gcc_arm64 ;; \
        *)     AQT_HOST=linux;       AQT_ARCH=gcc_64 ;; \
    esac && \
    /opt/aqt/bin/aqt install-qt "${AQT_HOST}" desktop "${QT_VERSION}" "${AQT_ARCH}" \
        --archives qtbase icu -O /opt/Qt --external 7z && \
    ln -s "$(find /opt/Qt -mindepth 2 -maxdepth 2 -type d | sort | tail -n1)" /opt/Qt/current

ENV QTDIR=/opt/Qt/current
ENV CMAKE_PREFIX_PATH=/opt/Qt/current
ENV PATH=/opt/Qt/current/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/Qt/current/lib:${LD_LIBRARY_PATH}
